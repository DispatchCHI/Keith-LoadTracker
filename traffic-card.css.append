
/* ——— Chicago traffic hot corridors ——— */
.traffic-card {
  margin: 12px 0 16px;
  padding: 0;
  border-radius: 16px;
  background: var(--panel);
  border: 1px solid var(--line);
  overflow: hidden;
}
.traffic-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  font: inherit;
}
.traffic-toggle-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.traffic-toggle-title {
  font-size: 15px;
  font-weight: 700;
}
.traffic-toggle-meta {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}
.traffic-toggle-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.traffic-refresh {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid var(--line);
  color: var(--muted);
  cursor: pointer;
}
.traffic-refresh:hover {
  color: var(--text);
  border-color: var(--accent, #e11);
}
.traffic-refresh.spinning svg {
  animation: traffic-spin 0.8s linear infinite;
}
@keyframes traffic-spin {
  to { transform: rotate(360deg); }
}
.traffic-card-collapsed .traffic-body {
  display: none;
}
.traffic-body {
  padding: 0 12px 12px;
  border-top: 1px solid var(--line);
}
.traffic-status {
  margin: 10px 2px;
  color: var(--muted);
  font-size: 12px;
}
.traffic-status.error {
  color: #f87171;
}
.traffic-status.warn {
  color: #fbbf24;
}
.traffic-empty {
  margin: 12px 2px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
}
.traffic-section {
  margin-top: 10px;
}
.traffic-section-title {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0 2px 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--muted);
}
.traffic-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.traffic-row {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  padding: 8px 10px;
  border-radius: 10px;
  background: color-mix(in srgb, var(--bg) 65%, transparent);
  border: 1px solid var(--line);
}
.traffic-row.incident {
  border-color: color-mix(in srgb, #f87171 45%, var(--line));
}
.traffic-row.incident .traffic-row-icon {
  color: #f87171;
}
.traffic-row.construction .traffic-row-icon {
  color: #fbbf24;
}
.traffic-row.travel .traffic-row-icon {
  color: #60a5fa;
}
.traffic-row.travel.cng-heavy {
  border-color: color-mix(in srgb, #f87171 40%, var(--line));
}
.traffic-row.travel.cng-medium {
  border-color: color-mix(in srgb, #fbbf24 40%, var(--line));
}
.traffic-row-icon {
  margin-top: 2px;
}
.traffic-row-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.traffic-row-title {
  font-size: 12px;
  font-weight: 700;
  line-height: 1.3;
}
.traffic-row-detail {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.35;
}
.traffic-attrib {
  margin: 10px 2px 0;
  font-size: 10px;
  color: var(--muted);
  opacity: 0.85;
}
